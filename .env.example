# Copy to .env and fill in. Never commit .env.

# Bearer tokens accepted by the MCP endpoint (comma separated, min 24 chars each).
# Generate with: openssl rand -hex 32
# An entry may also be a hash: sha256:<hex digest of the token>
MCP_AUTH_TOKENS=

# BMC credentials referenced from config/hosts.yaml via password_env / username_env.
# Use READ-ONLY accounts on the BMCs.
DELL01_USER=mcp-readonly
DELL01_PASSWORD=
ILO01_USER=mcp-readonly
ILO01_PASSWORD=

# Optional
# BMC_MAX_LOG_PAGES=20
# MCP_LOG_LEVEL=info
